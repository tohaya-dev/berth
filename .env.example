# .env.example
# cp .env.example .env して実際のキーを記入する
# .env は .gitignore に追加済みであること

# LLM API キーは設定UIで入力（このセッションのみ保持・保存しない。環境変数では設定不可）
CYNOVELA_LLM_BASE_URL=
CYNOVELA_LLM_MODEL=
CYNOVELA_EMBEDDING_API_KEY=
CYNOVELA_RERANKER_API_KEY=
CYNOVELA_CLASSIFIER_API_KEY=

# === VectorStore / Embedding 設定 (Eval-MCP Phase 4) ===
CYNOVELA_VECTOR_BACKEND=chroma        # chroma | qdrant | lancedb
CYNOVELA_EMBEDDING_BACKEND=bge_m3     # bge_m3 (推奨/100言語/MIT) | minilm | multilingual_e5 | lm_studio

# === K8s / リモート配備時 ===
# CYNOVELA_DB=/data/cynovela.db        # PVC マウントパス
# CYNOVELA_CHROMA=/data/chroma        # PVC マウントパス（任意の対応storage class）
# LM_STUDIO_URL=http://ollama:11434  # K8s 内 Service の URL (Ollama 等)

# === MCP Server 設定 (mcp_server.py) ===
# CYNOVELA_TOKEN=your-token-here      # 認証トークン（未設定時はデモトークンを使用）
# CYNOVELA_BASE=http://127.0.0.1:8765  # Cynovela API URL（CLI --cynovela-url より優先）

# === pytest 用認証トークン (Stage-2G-1) ===
# CYNOVELA_TOKEN=<画面のログインで発行されたトークン>  # DD-CYN-0116 U-1: 固定トークンは受け口で封鎖済み
# TEST_PORT=8765                       # テスト対象サーバーポート
